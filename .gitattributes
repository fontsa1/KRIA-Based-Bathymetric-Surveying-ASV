# Scripts keep Unix line endings even when the repo is cloned on Windows,
# so they run in WSL and on the KR260 ("$'\r': command not found" otherwise).
*.sh   text eol=lf
*.py   text eol=lf
*.tcl  text eol=lf
*.xdc  text eol=lf
*.v    text eol=lf
*.sv   text eol=lf
*.vh   text eol=lf
*.vhd  text eol=lf
*.xci  text eol=lf
